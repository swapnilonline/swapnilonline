# Leads by email (simplest). Create a free account at resend.com, make an API key, set these three.
RESEND_API_KEY=
LEAD_TO_EMAIL=digital@swapnilonline.com
# Sender. Until the domain is verified in Resend, leave this empty to use onboarding@resend.dev.
LEAD_FROM_EMAIL=

# Optional second channel: every quiz lead and call application is also POSTed here as JSON.
# Easiest free option: the Google Apps Script in scripts/apps-script/Code.gs (writes to a Sheet + emails you).
LEAD_WEBHOOK_URL=
# Shared secret. Set the same value in Code.gs. Sent as a bearer header and in the JSON body.
LEAD_WEBHOOK_SECRET=

# Calendly booking page embedded after a qualified application.
NEXT_PUBLIC_CAL_URL=https://calendly.com/swapnilonline/launch-call

# WhatsApp click-to-chat number, digits only with country code, e.g. 919876543210.
# Enables the "Message Swapnil on WhatsApp" button on the result page.
NEXT_PUBLIC_WHATSAPP=

# Optional. Google Analytics 4 measurement id, e.g. G-XXXXXXX. Leave empty to disable.
NEXT_PUBLIC_GA_ID=

# Optional. The home page plays /home-video.mp4 by default. Set a YouTube id (the part after v=) to use YouTube instead.
NEXT_PUBLIC_HOME_VIDEO_ID=
